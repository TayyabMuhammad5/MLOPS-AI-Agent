# MLOps AI Agent — Example Environment Configuration (.env.example)

# Copy this file to `.env` for local execution:

#   cp .env.example .env

# NEVER commit `.env` with real API keys, Kubernetes tokens, or credentials.



# Application & Deployed Model Metadata

APP_VERSION=v2.1.0

MODEL_NAME=churn-classifier

MODEL_VERSION=2

MODEL_STAGE=Production

MLFLOW_RUN_ID=run_25_lgbm_candidate



# DVC & Git Provenance Configuration

MLOPS_REPO_ROOT=.

DVC_DATASET_VERSION=v2.1

GIT_COMMIT=a4c92e1

DVC_REMOTE_URL=s3://mlops-course-dvc-store/churn-datasets



# MLflow Tracking Server Configuration

MLFLOW_TRACKING_URI=http://localhost:5000

MLFLOW_EXPERIMENT_NAME=churn-prediction-prod



# Apache Airflow 3 REST API Configuration

AIRFLOW_API_URL=http://localhost:8080/api/v2

AIRFLOW_API_TOKEN=replace-with-local-airflow-jwt-token



# Kubernetes Operations Configuration

KUBERNETES_NAMESPACE=mlops-prod

APPROVED_NAMESPACES=mlops-prod,mlops-staging



# Groq LLM Configuration (used by agent/orchestrator.py when GROQ_API_KEY is set)

LLM_PROVIDER=groq

GROQ_API_KEY=replace-with-your-groq-api-key-gsk_xxxx

GROQ_MODEL=openai/gpt-oss-120b

LOG_LEVEL=INFO

